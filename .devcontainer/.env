# Dev Container Environment Override
# This file is used by the dev container to override .docker/.dist.env settings

# Uncomment and modify any settings below to override defaults from .docker/.dist.env

# Database
# MYSQL_HOST=db
# MYSQL_PORT=3306
# MYSQL_DATABASE=friendica
# MYSQL_USER=friendica
# MYSQL_PASSWORD=friendica
# MYSQL_ROOT_PASSWORD=root

# Redis
# REDIS_HOST=redis

# PHP Settings
# PHP_MEMORY_LIMIT=512M
# PHP_MAX_EXECUTION_TIME=300

# Webserver
# SERVER_PORT=8080

# Test users
# ADMIN_NICK=admin
# ADMIN_PASSW=admin
# USER_NICK=user
# USER_PASSW=user
